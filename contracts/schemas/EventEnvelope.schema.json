{
  "$defs": {
    "ActorType": {
      "enum": [
        "user",
        "service",
        "system"
      ],
      "title": "ActorType",
      "type": "string"
    },
    "EventType": {
      "enum": [
        "project.created",
        "state.changed",
        "task.requested",
        "task.updated",
        "task.failed",
        "task.cancel_requested",
        "artifact.committed",
        "artifact.invalidated",
        "approval.required",
        "approval.recorded",
        "approval.invalidated",
        "rule.changed",
        "budget.threshold",
        "package.ready",
        "project.control"
      ],
      "title": "EventType",
      "type": "string"
    }
  },
  "properties": {
    "actor_id": {
      "title": "Actor Id",
      "type": "string"
    },
    "actor_type": {
      "$ref": "#/$defs/ActorType"
    },
    "correlation_id": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Correlation Id"
    },
    "event_id": {
      "format": "uuid",
      "title": "Event Id",
      "type": "string"
    },
    "input_manifest_hash": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Input Manifest Hash"
    },
    "occurred_at": {
      "format": "date-time",
      "title": "Occurred At",
      "type": "string"
    },
    "output_artifact_ids": {
      "items": {
        "format": "uuid",
        "type": "string"
      },
      "title": "Output Artifact Ids",
      "type": "array"
    },
    "payload": {
      "additionalProperties": true,
      "title": "Payload",
      "type": "object"
    },
    "project_id": {
      "anyOf": [
        {
          "format": "uuid",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Project Id"
    },
    "schema_version": {
      "default": 1,
      "title": "Schema Version",
      "type": "integer"
    },
    "task_id": {
      "anyOf": [
        {
          "format": "uuid",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Task Id"
    },
    "tenant_id": {
      "format": "uuid",
      "title": "Tenant Id",
      "type": "string"
    },
    "type": {
      "$ref": "#/$defs/EventType"
    },
    "workflow_id": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Workflow Id"
    }
  },
  "required": [
    "event_id",
    "tenant_id",
    "type",
    "occurred_at",
    "actor_type",
    "actor_id"
  ],
  "title": "EventEnvelope",
  "type": "object"
}
