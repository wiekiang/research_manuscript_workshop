{
  "$defs": {
    "ArtifactStatus": {
      "enum": [
        "ARTIFACT_COMMITTED",
        "AVAILABLE_TO_WORKFLOW"
      ],
      "title": "ArtifactStatus",
      "type": "string"
    },
    "DataClassification": {
      "enum": [
        "public",
        "internal",
        "restricted"
      ],
      "title": "DataClassification",
      "type": "string"
    },
    "Freshness": {
      "enum": [
        "current",
        "stale"
      ],
      "title": "Freshness",
      "type": "string"
    }
  },
  "properties": {
    "classification": {
      "$ref": "#/$defs/DataClassification"
    },
    "committed_at": {
      "anyOf": [
        {
          "format": "date-time",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Committed At"
    },
    "content_hash": {
      "title": "Content Hash",
      "type": "string"
    },
    "created_at": {
      "format": "date-time",
      "title": "Created At",
      "type": "string"
    },
    "freshness": {
      "$ref": "#/$defs/Freshness"
    },
    "id": {
      "format": "uuid",
      "title": "Id",
      "type": "string"
    },
    "input_manifest_hash": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Input Manifest Hash"
    },
    "kind": {
      "title": "Kind",
      "type": "string"
    },
    "label": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Label"
    },
    "media_type": {
      "title": "Media Type",
      "type": "string"
    },
    "project_id": {
      "anyOf": [
        {
          "format": "uuid",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "title": "Project Id"
    },
    "size_bytes": {
      "title": "Size Bytes",
      "type": "integer"
    },
    "status": {
      "$ref": "#/$defs/ArtifactStatus"
    },
    "task_id": {
      "anyOf": [
        {
          "format": "uuid",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Task Id"
    }
  },
  "required": [
    "id",
    "project_id",
    "kind",
    "content_hash",
    "size_bytes",
    "media_type",
    "status",
    "freshness",
    "classification",
    "created_at"
  ],
  "title": "ArtifactOut",
  "type": "object"
}
