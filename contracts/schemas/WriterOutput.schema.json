            "observed_result",
            "method",
            "interpretation",
            "hypothesis",
            "limitation",
            "contribution_statement",
            "framing"
          ],
          "title": "Kind",
          "type": "string"
        },
        "result_keys": {
          "items": {
            "type": "string"
          },
          "title": "Result Keys",
          "type": "array"
        },
        "text": {
          "title": "Text",
          "type": "string"
        }
      },
      "required": [
        "text",
        "kind",
        "claim_ids",
        "result_keys"
      ],
      "title": "DraftSpan",
      "type": "object"
    },
    "SectionDraft": {
      "properties": {
        "heading": {
          "title": "Heading",
          "type": "string"
        },
        "key": {
          "title": "Key",
          "type": "string"
        },
        "open_questions": {
          "items": {
            "type": "string"
          },
