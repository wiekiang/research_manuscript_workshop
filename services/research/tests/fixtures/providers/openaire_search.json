202 electrical engineering, electronic engineering, information engineering"},"provenance":null},{"subject":{"scheme":"keyword","value":"provenance"},"provenance":null},{"subject":{"scheme":"FOS","value":"02 engineering and technology"},"provenance":null},{"subject":{"scheme":"keyword","value":"Cloud Computing"},"provenance":null}],"mainTitle":"Computational Reproducibility Validation in Cloud Big Data Pipelines Through Provenance and Machine Learning","subTitle":null,"descriptions":["This deposit contains all artefacts required to reproduce the experimental results reported in Paper 3 of the PhD thesis *Computational Reproducibility and Provenance in Cloud-Based Climate Data Applications*. The work proposes and validates a three-layer computational reproducibility scoring framework that uses provenance metadata and machine learning to assess whether a scientific workflow can be reliably reproduced across different cloud platforms."],"publicationDate":"2026-04-02","publisher":"Zenodo","embargoEndDate":null,"sources":null,"formats":null,"contributors":null,"coverages":null,"bestAccessRight":{"code":"c_abf2","label":"OPEN","scheme":"http://vocabularies.coar-repositories.org/documentation/access_rights/"},"container":null,"documentationUrls":null,"codeRepositoryUrl":null,"programmingLanguage":null,"contactPeople":null,"contactGroups":null,"tools":null,"size":null,"version":null,"geoLocations":null,"id":"doi_dedup___::2de0bd8e2ab325e88dd36922635428b3","originalIds":["50|datacite____::2de0bd8e2ab325e88dd36922635428b3","10.5281/zenodo.19389219","50|datacite____::587c164580b04b0947081701b20fd8d3","10.5281/zenodo.19389220","oai:zenodo.org:19389220","50|od______2659::587c164580b04b0947081701b20fd8d3"],"pids":[{"scheme":"doi","value":"10.5281/zenodo.19389219"},{"scheme":"doi","value":"10.5281/zenodo.19389220"}],"dateOfCollection":null,"lastUpdateTimeStamp":null,"indicators":{"citationImpact":{"citationCount":0.0,"influence":2.1746283E-9,"popularity":2.6085654E-9,"impulse":0.0